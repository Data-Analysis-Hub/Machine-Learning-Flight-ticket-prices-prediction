         "source": [
            "#### Preprocessing (Encoding) \n",
            "categorical_df=df[['airline','source_city','destination_city','days_left','arrival_time','departure_time']]\n",
            "encoder_cat=preprocessing.OneHotEncoder(sparse_output=False)\n",
            "array_encoded = encoder_cat.fit_transform(categorical_df)\n",
            "\n",
            "encoded_cat = pd.DataFrame(\n",
            "    array_encoded,\n",
            "    columns = encoder_cat.get_feature_names_out(categorical_df.columns)\n",
            ")\n",
            "encoded_cat"
         ]
      },
